# ReviveAI Environment Configuration

# Database Connection (defaults canonically to backend/reviveai.db)
DATABASE_URL=

# AI Agent Configuration (Google Gemini API Key - optional, heuristic reasoner active if empty)
GEMINI_API_KEY=

# Deterministic Financial Safety Guardrails
APPROVAL_THRESHOLD_INR=50000.0
MAX_RETRIES=2
MAX_NOTIFICATIONS=1
RECOVERY_WINDOW_HOURS=24
AUTO_TERMINATE_ON_SUCCESS=true
