# ReviveAI Sovereign Environment Configuration Template
# DO NOT COMMIT REAL PRODUCTION SECRETS TO REPOSITORY

# Database Connection (defaults canonically to sqlite:///backend/reviveai.db if unset)
DATABASE_URL=sqlite:///reviveai.db

# Authentication & Sovereign Cryptography
REVIVEAI_JWT_SECRET=your-256-bit-jwt-secret-key-here
STRICT_AUTH=false
DEV_AUTO_AUTH=true

# AI Agent Configuration (Google Gemini API Key - optional, heuristic reasoner active if empty)
GEMINI_API_KEY=

# Payment Provider Configuration
# Supported Modes: "simulation", "razorpay_test", "razorpay_live"
PAYMENT_PROVIDER_MODE=simulation
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Deterministic Financial Safety Guardrails
APPROVAL_THRESHOLD_INR=50000.0
MAX_RETRIES=2
MAX_NOTIFICATIONS=1
RECOVERY_WINDOW_HOURS=24
AUTO_TERMINATE_ON_SUCCESS=true

# Idempotency & Durable Scheduling
IDEMPOTENCY_EXPIRY_SECONDS=86400
RETRY_SCHEDULER_ENABLED=true
